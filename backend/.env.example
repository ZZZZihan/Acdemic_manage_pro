# Copy to backend/.env and replace every placeholder.
# The process refuses to start if SECRET_KEY or JWT_SECRET_KEY is missing,
# shorter than 32 characters, or one of the placeholder values below.

FLASK_CONFIG=development
FLASK_DEBUG=false

SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-another-32-plus-random-characters

# Comma-separated browser origins. "*" is rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite path used when DEV_DATABASE_URL is unset: backend/data-dev.sqlite
DEV_DATABASE_URL=
DATABASE_URL=

# Retrieval is off until you opt in. CRUD does not load an embedding model.
RAG_ENABLED=false
RAG_RETRIEVER=vector
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional generation providers. Leave blank to disable generation.
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat

# Demo seed. Passwords are required by seed_demo.py and are not stored here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
MEMBER_EMAIL=member@example.com
MEMBER_PASSWORD=

# Optional JSONL audit file. Empty means stdout only.
AUDIT_LOG_PATH=

AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60

API_CONNECT_TIMEOUT=10
API_READ_TIMEOUT=90
API_MAX_RETRIES=3
